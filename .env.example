NODE_ENV=development
PORT=4201

# Backend-authoritative karaoke entitlement settings.
FREE_DAILY_KARAOKE_MINUTES=120
# KantaTube business calendar is fixed to Asia/Manila; this legacy setting is ignored.
FREE_USAGE_RESET_TIMEZONE=Asia/Manila
USAGE_DISCONNECT_GRACE_SECONDS=60
USAGE_HEARTBEAT_GAP_CAP_SECONDS=60
ALLOW_CURRENT_SONG_TO_FINISH_AFTER_LIMIT=true
MAX_CURRENT_SESSIONS=1

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=kantatube
DB_SSL=false

# Browser-facing application URLs. In production, proxy /api through the
# frontend domain so session cookies remain first-party.
APP_FRONTEND_URL=http://localhost:4200
REMOTE_PAIRING_TOKEN_SECONDS=600
REMOTE_REQUEST_EXPIRY_SECONDS=60
REMOTE_GRANT_LIFETIME_HOURS=12
APP_FRONTEND_URLS=http://localhost:4200,http://192.168.254.103:4200
APP_BACKEND_URL=http://localhost:4201
MAX_KARAOKE_QUEUE_SIZE=15
# Buy Me a Coffee. Invalid or omitted values use the documented safe defaults.
BUY_ME_A_COFFEE_AUTO_SHOW=false
BUY_ME_A_COFFEE_AFTER_COMPLETED_SONGS=6
BUY_ME_A_COFFEE_COOLDOWN_DAYS=7
BUY_ME_A_COFFEE_MAX_AUTO_SHOW_PER_SESSION=1
BUY_ME_A_COFFEE_MANUAL_OPEN_COUNTS_AS_SHOWN=true
BUY_ME_A_COFFEE_MANUAL_OPEN_RESETS_COOLDOWN=true
# Karaoke session inactivity timeout, in seconds. The client sends a heartbeat
# every 15 seconds while the karaoke screen is active. If the server has not
# received a heartbeat for this duration, it expires the session, clears its
# queued songs, and frees its active-session slot. Expiration is checked about
# every 30 seconds, so cleanup can occur shortly after this period.
#
# 1800 seconds = 30 minutes. This is forgiving of temporary network loss or a
# sleeping device, but an abandoned session can keep a slot for up to roughly
# 30 minutes. Lower this value when slots should be released sooner.
KARAOKE_SESSION_LEASE_SECONDS=1800

# Maximum number of active karaoke sessions an account can own at one time.
# This is set to 1, so an account must end, move, or resume its existing
# session before it can use another device. Keep this aligned with the
# frontend session limit.
MAX_ACTIVE_SESSIONS=1

# Authentication session. Production defaults should use Secure=true and Lax.
SESSION_COOKIE_NAME=kantatube_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_SECONDS=2592000
ACCOUNT_RECOVERY_PERIOD_DAYS=30
ACCOUNT_RECOVERY_OTP_TTL_MINUTES=10
ACCOUNT_RECOVERY_OTP_MAX_ATTEMPTS=5
ACCOUNT_RECOVERY_RESEND_COOLDOWN_SECONDS=60
ACCOUNT_RECOVERY_EMAILS_PER_DAY=5
ACCOUNT_RECOVERY_REQUESTS_PER_IP_HOUR=10
ACCOUNT_RECOVERY_TOKEN_TTL_MINUTES=10

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4201/api/auth/google/callback

FACEBOOK_APP_ID=replace-with-facebook-app-id
FACEBOOK_APP_SECRET=replace-with-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:4201/api/auth/facebook/callback
FACEBOOK_GRAPH_VERSION=v23.0

# Email verification (Brevo). If omitted in local development, the code is logged by the backend.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=KantaTube
ACCOUNT_EMAIL_TIME_ZONE=Asia/Manila
SUPPORT_EMAIL=

# Previous Resend configuration (kept for reference only).
# RESEND_API_KEY=
# MAIL_FROM="KantaTube <onboarding@resend.dev>"

# Keep key values server-side. Aliases may be shown in Angular, values must not be.
YOUTUBE_API_KEYS={"primary":"replace-with-key","backup":"replace-with-key"}
YOUTUBE_DEFAULT_API_KEY_ALIAS=primary
# When true, quota-exhausted server aliases are tried in configured order.
# Invalid or omitted values are treated as false.
AUTO_SWITCH_KEY=false
# A known-exhausted alias is skipped for 10 minutes in this backend process.

# Personal keys are stored only in backend memory, keyed by visitor ID. They
# remain until explicitly removed or until the backend process restarts.
YOUTUBE_PERSONAL_KEYS_ENABLED=true
YOUTUBE_PERSONAL_KEY_MAX_SESSIONS=200
YOUTUBE_SEARCH_CACHE_TTL_MS=21600000
YOUTUBE_SEARCH_CACHE_MAX_ENTRIES=500

# Optional fallback for deployments that use only one key.
YOUTUBE_API_KEY=
